---
import { labels, site } from "../data/site";
import type { Locale } from "../types";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  alternateHref?: string;
}

const { locale, title, description, alternateHref } = Astro.props;
const copy = labels[locale];
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const pageDescription = description ?? site.description[locale];
const alternateLocale = locale === "zh" ? "en" : "zh";
const currentPath = Astro.url.pathname;
const fallbackAlternatePath = currentPath.replace(`/${locale}/`, `/${alternateLocale}/`);
const languageSwitchHref = alternateHref ?? fallbackAlternatePath;
const currentLangLabel = locale.toUpperCase();
const alternateLangLabel = alternateLocale.toUpperCase();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" hrefLang="zh" href={`${site.url}/zh/`} />
    <link rel="alternate" hrefLang="en" href={`${site.url}/en/`} />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href={`/${locale}/rss.xml`} />
    <style is:global>
      :root {
        --bg: #091015;
        --bg-soft: rgba(9, 16, 21, 0.72);
        --panel: rgba(14, 24, 30, 0.8);
        --line: rgba(121, 255, 168, 0.16);
        --text: #d7e4de;
        --text-dim: #94aaa0;
        --accent: #79ffa8;
        --accent-strong: #b8ff6d;
        --warn: #ffcc66;
        --shadow: rgba(0, 0, 0, 0.3);
        --mono: "Cascadia Code", "JetBrains Mono", "Fira Code", monospace;
        --sans: "IBM Plex Sans", "Segoe UI", sans-serif;
      }
      * { box-sizing: border-box; }
      html {
        background:
          radial-gradient(circle at top, rgba(121, 255, 168, 0.09), transparent 32%),
          linear-gradient(180deg, #071015 0%, #091015 55%, #060b0e 100%);
        color: var(--text);
        font-family: var(--sans);
        min-height: 100%;
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        min-height: 100vh;
        background-image:
          linear-gradient(rgba(121, 255, 168, 0.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(121, 255, 168, 0.03) 1px, transparent 1px);
        background-size: 24px 24px;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { color: var(--accent-strong); }
      main { width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding: 32px 0 72px; }
      .shell { background: var(--bg-soft); border: 1px solid var(--line); border-radius: 20px; box-shadow: 0 24px 60px var(--shadow); overflow: hidden; backdrop-filter: blur(12px); }
      .shell-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 18px; border-bottom: 1px solid var(--line); }
      .shell-dots { display: flex; gap: 8px; }
      .shell-dots span { width: 10px; height: 10px; border-radius: 50%; background: rgba(255, 255, 255, 0.18); }
      .shell-dots span:nth-child(1) { background: #ff7b72; }
      .shell-dots span:nth-child(2) { background: #f2cc60; }
      .shell-dots span:nth-child(3) { background: #7ee787; }
      .shell-top code, .meta-strip, nav, .chip, .tag, .mono, .lang-switcher { font-family: var(--mono); }
      header.site-header { padding: 22px 22px 10px; }
      .header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-top: 18px;
        flex-wrap: nowrap;
      }
      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        align-items: center;
        flex: 1 1 auto;
        min-width: 0;
      }
      nav a { color: var(--text-dim); display: inline-flex; align-items: center; min-height: 34px; line-height: 1; }
      nav a:hover, nav a[aria-current="page"] { color: var(--accent); }
      .lang-switcher {
        display: inline-flex;
        align-items: center;
        border: 1px solid rgba(121, 255, 168, 0.42);
        border-radius: 999px;
        background: linear-gradient(135deg, rgba(121, 255, 168, 0.12), rgba(184, 255, 109, 0.08));
        overflow: hidden;
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.05);
        flex: 0 0 auto;
        margin-left: auto;
      }
      .lang-segment {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 52px;
        min-height: 38px;
        padding: 0 14px;
        color: var(--text-dim);
        line-height: 1;
      }
      .lang-segment + .lang-segment {
        border-left: 1px solid rgba(121, 255, 168, 0.24);
      }
      .lang-segment-active {
        background: rgba(9, 16, 21, 0.55);
        color: var(--text);
        font-weight: 600;
      }
      .lang-segment-link {
        color: var(--accent);
      }
      .lang-segment-link:hover {
        background: rgba(121, 255, 168, 0.1);
        color: var(--accent-strong);
      }
      .content { padding: 12px 22px 26px; }
      .grid { display: grid; grid-template-columns: 1.4fr 0.9fr; gap: 22px; }
      .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 18px; padding: 20px; }
      .hero-kicker { color: var(--accent); font-size: 0.82rem; letter-spacing: 0.16em; text-transform: uppercase; }
      h1, h2, h3 { margin: 0 0 12px; }
      h1 { font-size: clamp(2rem, 4vw, 3.8rem); line-height: 0.96; max-width: 12ch; }
      p { color: var(--text-dim); line-height: 1.8; }
      ul.clean { list-style: none; padding: 0; margin: 0; }
      .post-list { display: grid; gap: 14px; }
      .post-card { display: block; border: 1px solid var(--line); border-radius: 16px; padding: 16px; background: rgba(255, 255, 255, 0.02); transition: transform 180ms ease, border-color 180ms ease; }
      .post-card:hover { transform: translateY(-2px); border-color: rgba(121, 255, 168, 0.3); }
      .meta-strip { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 10px; font-size: 0.84rem; color: var(--warn); }
      .chip, .tag { display: inline-flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 999px; border: 1px solid var(--line); color: var(--text); }
      .chip-active { border-color: rgba(121, 255, 168, 0.42); color: var(--accent); }
      .chip-disabled { opacity: 0.45; pointer-events: none; }
      .tag-row, .pagination { display: flex; flex-wrap: wrap; gap: 10px; }
      .pagination { margin-top: 18px; }
      article.prose { max-width: 75ch; }
      article.prose p + p { margin-top: 1rem; }
      .cover-panel { margin-bottom: 14px; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: linear-gradient(135deg, rgba(121, 255, 168, 0.12), rgba(9, 16, 21, 0.4)); min-height: 220px; position: relative; }
      .cover-panel-compact { min-height: 150px; }
      .cover-panel img, .cover-fallback { display: block; width: 100%; height: 100%; min-height: inherit; object-fit: cover; }
      .cover-fallback { position: relative; padding: 18px; background: linear-gradient(135deg, rgba(121, 255, 168, 0.08), rgba(184, 255, 109, 0.04), rgba(9, 16, 21, 0.5)); }
      .cover-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(121, 255, 168, 0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(121, 255, 168, 0.06) 1px, transparent 1px); background-size: 24px 24px; }
      .cover-copy { position: relative; z-index: 1; display: grid; gap: 8px; align-content: end; min-height: inherit; }
      .cover-copy strong { font-size: clamp(1.4rem, 3vw, 2.2rem); max-width: 14ch; }
      footer.site-footer { padding: 0 22px 22px; color: var(--text-dim); }
      @media (max-width: 640px) {
        .header-row { align-items: flex-start; flex-direction: column; }
        .lang-switcher { margin-left: 0; }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="shell">
        <div class="shell-top">
          <div class="shell-dots" aria-hidden="true"><span></span><span></span><span></span></div>
          <code>{site.title}</code>
        </div>
        <header class="site-header">
          <div class="mono">{site.email}</div>
          <div class="header-row">
            <nav aria-label="Primary">
              {site.nav[locale].map((item) => (
                <a href={item.href} aria-current={Astro.url.pathname === item.href ? "page" : undefined}>{item.label}</a>
              ))}
            </nav>
            <div class="lang-switcher" aria-label="Language switcher">
              <span class="lang-segment lang-segment-active" aria-current="true">{currentLangLabel}</span>
              <a class="lang-segment lang-segment-link" href={languageSwitchHref}>{alternateLangLabel}</a>
            </div>
          </div>
        </header>
        <div class="content"><slot /></div>
        <footer class="site-footer"><span>{copy.email}: </span><a href={`mailto:${site.email}`}>{site.email}</a></footer>
      </div>
    </main>
  </body>
</html>
