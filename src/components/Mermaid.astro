---
interface Props {
  chart: string;
  zoom?: number;
}

const { chart, zoom = 1 } = Astro.props;
---

<div class="mermaid-wrap" data-zoom={zoom}>
  <div class="mermaid-chart" data-chart={chart} />
</div>

<script>
  import mermaid from "mermaid";

  function diagramId() {
    if (typeof crypto !== "undefined" && "randomUUID" in crypto) {
      return `mmd-${crypto.randomUUID()}`;
    }
    return `mmd-${Math.random().toString(36).slice(2, 12)}`;
  }

  mermaid.initialize({
    startOnLoad: false,
    securityLevel: "loose",
    theme: "neutral",
    fontFamily: "ui-sans-serif, system-ui, sans-serif"
  });

  const charts = document.querySelectorAll<HTMLElement>(".mermaid-chart[data-chart]:not([data-rendered])");
  for (const el of charts) {
    const chartText = el.dataset.chart;
    if (!chartText) continue;

    el.dataset.rendered = "true";
    void mermaid.render(diagramId(), chartText).then(
      ({ svg }) => {
        el.innerHTML = svg;

        const wrap = el.closest<HTMLElement>(".mermaid-wrap");
        const zoom = Number(wrap?.dataset.zoom ?? 1);
        const svgEl = el.querySelector("svg");
        if (!svgEl) return;

        const viewBox = svgEl.getAttribute("viewBox");
        if (!viewBox) return;

        const [, , w, h] = viewBox.split(/\s+/).map(Number);
        if (!w || !h) return;

        let width = w * zoom;
        let height = h * zoom;

        if (wrap) {
          const maxWidth = wrap.clientWidth;
          if (maxWidth > 0 && width > maxWidth) {
            const scale = maxWidth / width;
            width = maxWidth;
            height = height * scale;
          }
        }

        svgEl.setAttribute("width", String(width));
        svgEl.setAttribute("height", String(height));
        svgEl.style.removeProperty("max-width");
      },
      (err) => {
        el.innerHTML = `<pre class="mermaid-error">${String(err)}</pre>`;
      }
    );
  }
</script>

<style>
  .mermaid-wrap {
    margin: 1.5rem 0;
    overflow-x: auto;
    width: 100%;
  }

  .mermaid-chart {
    display: block;
    width: max-content;
    margin-inline: auto;
  }

  .mermaid-wrap:not(:has(.mermaid-error)) {
    display: block;
  }

  .mermaid-chart :global(svg) {
    display: block;
    max-width: none;
  }

  .mermaid-error {
    color: var(--text-dim, #666);
    font-size: 0.85rem;
    white-space: pre-wrap;
  }
</style>
