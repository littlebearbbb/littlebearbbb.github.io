---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Pagination from "../../../../components/Pagination.astro";
import PostList from "../../../../components/PostList.astro";
import { LOGS_PAGE_SIZE, getLogs, paginateEntries } from "../../../../lib/content";

export async function getStaticPaths() {
  const posts = await getLogs("en");
  const totalPages = Math.ceil(posts.length / LOGS_PAGE_SIZE);
  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => ({
    params: { page: String(index + 2) }
  }));
}

const locale = "en";
const currentPage = Number(Astro.params.page ?? "1");
const allPosts = await getLogs(locale);
const page = paginateEntries(allPosts, currentPage, LOGS_PAGE_SIZE);
---

<BaseLayout locale={locale} title={`Logs / Page ${page.page}`}>
  <section class="panel">
    <h1>Logs</h1>
    <PostList locale={locale} posts={page.items} />
    <Pagination locale={locale} currentPage={page.page} totalPages={page.totalPages} basePath="/en/logs" />
  </section>
</BaseLayout>
