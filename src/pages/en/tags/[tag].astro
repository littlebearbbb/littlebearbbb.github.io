---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostList from "../../../components/PostList.astro";
import { getLogsByTag, getTagCounts } from "../../../lib/content";

export async function getStaticPaths() {
  const tags = await getTagCounts("en");
  return tags.map((tag) => ({ params: { tag: tag.slug } }));
}

const locale = "en";
const slug = Astro.params.tag!;
const tags = await getTagCounts(locale);
const currentTag = tags.find((item) => item.slug === slug);
const posts = await getLogsByTag(locale, slug);

if (!currentTag) {
  throw new Error(`Missing tag: ${slug}`);
}
---

<BaseLayout locale={locale} title={`Tag / ${currentTag.tag}`}>
  <section class="panel">
    <h1>#{currentTag.tag}</h1>
    <p>{currentTag.count} entries</p>
    <PostList locale={locale} posts={posts} />
  </section>
</BaseLayout>
